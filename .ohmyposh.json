{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "transient_prompt": {
    "template": "\ue285 ",
    "foreground": "#d6deeb",
    "background": "transparent"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\u256d\u2500\ue0b6",
          "trailing_diamond": "\ue0b0",
          "foreground": "#011627",
          "background": "#21c7a8",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} "
        },
        {
          "type": "root",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#ffeb95",
          "background": "#ef5350",
          "template": " \uf292 "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#011627",
          "background": "#82AAFF",
          "template": " {{ .Path }} ",
          "options": {
            "style": "folder",
            "home_icon": "\ueb06 "
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#011627",
          "background": "#addb67",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#e4cf6a{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#f78c6c{{ end }}",
            "{{ if gt .Ahead 0 }}#C792EA{{ end }}",
            "{{ if gt .Behind 0 }}#c792ea{{ end }}"
          ],
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }} ",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "aws",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "foreground": "#faa029",
          "background": "#565656",
          "template": " \ue7ad {{ .Profile }} "
        },
        {
          "type": "kubectl",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "foreground": "#ffffff",
          "background": "#316ce4",
          "template": " \udb84\udcfe {{.Context}} ",
          "options": {
            "display_default": false
          }
        },
        {
          "type": "terraform",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "foreground": "#ffffff",
          "background": "#8839ef",
          "template": " \ue69a {{ .WorkspaceName }} ",
          "options": {
            "fetch_version": false
          }
        },
        {
          "type": "node",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "foreground": "#3C873A",
          "background": "#303030",
          "template": " \ue718 {{ .Full }} ",
          "options": {
            "fetch_version": true
          }
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#011627",
          "background": "#d6deeb",
          "template": " {{ .FormattedMs }} ",
          "options": {
            "threshold": 500,
            "style": "roundrock"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#21c7a8",
          "template": "\u2570\u2500"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#22da6e",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ef5350{{ end }}"
          ],
          "template": "\ue285\ue285",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}